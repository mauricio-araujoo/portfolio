<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Projetos on Mauricio F. Araujo</title><link>https://mauricio-araujoo.github.io/portfolio/projetos/</link><description>Recent content in Projetos on Mauricio F. Araujo</description><generator>Hugo</generator><language>pt-br</language><lastBuildDate>Thu, 23 Jul 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://mauricio-araujoo.github.io/portfolio/projetos/index.xml" rel="self" type="application/rss+xml"/><item><title>Plataforma web de gestão jurídica</title><link>https://mauricio-araujoo.github.io/portfolio/projetos/plataforma-gestao-juridica/</link><pubDate>Thu, 23 Jul 2026 00:00:00 +0000</pubDate><guid>https://mauricio-araujoo.github.io/portfolio/projetos/plataforma-gestao-juridica/</guid><description>&lt;h2 id="contexto"&gt;
